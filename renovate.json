{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "* 12-23 * * 0",
    "* 0-11 * * 1"
  ],
  "minimumReleaseAge": "48 hours",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "25 hours",
    "schedule": []
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "cf and @cloudflare/vite-plugin pin the same exact miniflare, workerd and @cloudflare/* packages. Bumping one alone installs two copies of each.",
      "matchPackageNames": [
        "cf",
        "@cloudflare/vite-plugin"
      ],
      "groupName": "Cloudflare build tools"
    }
  ]
}
